{
  "name": "telesoccer-rp",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo web mobile-first do Telesoccer RP.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @telesoccer-rp/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @telesoccer-rp/database db:generate",
    "db:migrate": "pnpm --filter @telesoccer-rp/database db:migrate",
    "db:push": "pnpm --filter @telesoccer-rp/database db:push",
    "db:studio": "pnpm --filter @telesoccer-rp/database db:studio"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.5.0"
}
